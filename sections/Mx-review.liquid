      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#7C3AED"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Background",
      "default": "#D4F7DC"
    },
    {
