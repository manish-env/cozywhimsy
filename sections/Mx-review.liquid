
{% comment %}
  Dermatologist Reviews Section
  A customizable carousel section for displaying professional testimonials
{% endcomment %}

<div class="dermatologist-reviews-section" data-section-id="{{ section.id }}">
  {% if section.blocks.size > 0 %}
    <div class="reviews-container">
      <!-- Badge -->
      {% if section.settings.show_badge %}
        <div class="reviews-badge">
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      <!-- Title -->
      {% if section.settings.title != blank %}
        <h2 class="reviews-title">{{ section.settings.title }}</h2>
      {% endif %}

      <!-- Reviews Carousel -->
      <div class="reviews-carousel-wrapper">
        <div class="reviews-carousel" id="reviews-carousel-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="review-slide{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="review-content">
                <!-- Doctor Image -->
                <div class="review-image">
                  {% if block.settings.doctor_image != blank %}
                    <img src="{{ block.settings.doctor_image | img_url: '400x500' }}" 
                         alt="{{ block.settings.doctor_name }}"
                         loading="lazy">
                  {% else %}
                    <div class="placeholder-image">
                      <svg width="120" height="150" viewBox="0 0 120 150" fill="none">
                        <rect width="120" height="150" fill="#E5E7EB"/>
                        <circle cx="60" cy="45" r="20" fill="#9CA3AF"/>
                        <path d="M30 120 Q60 100 90 120 V150 H30 V120" fill="#9CA3AF"/>
                      </svg>
                    </div>
                  {% endif %}
                </div>

                <!-- Review Details -->
                <div class="review-details">
                  <!-- Avatar Navigation -->
                  <div class="avatar-navigation">
                    {% for avatar_block in section.blocks %}
                      <button class="avatar-btn{% if forloop.index0 == forloop.parentloop.index0 %} active{% endif %}" 
                              data-slide="{{ forloop.index0 }}"
                              aria-label="View review {{ forloop.index }}">
                        {% if avatar_block.settings.avatar_image != blank %}
                          <img src="{{ avatar_block.settings.avatar_image | img_url: '60x60' }}" 
                               alt="{{ avatar_block.settings.doctor_name }}">
                        {% else %}
                          <div class="avatar-placeholder">
                            {{ avatar_block.settings.doctor_name | slice: 0, 1 | upcase }}
                          </div>
                        {% endif %}
                      </button>
                    {% endfor %}
                  </div>

                  <!-- Star Rating -->
                  <div class="star-rating">
                    {% for i in (1..5) %}
                      <svg class="star{% if i <= block.settings.rating %} filled{% endif %}" 
                           width="20" height="20" viewBox="0 0 20 20">
                        <path d="M10 1L12.09 7.26L19 7.27L13.18 11.97L15.27 18.23L10 13.53L4.73 18.23L6.82 11.97L1 7.27L7.91 7.26L10 1Z"/>
                      </svg>
                    {% endfor %}
                  </div>

                  <!-- Review Text -->
                  {% if block.settings.review_text != blank %}
                    <p class="review-text">{{ block.settings.review_text }}</p>
                  {% endif %}

                  <!-- Doctor Info -->
                  <div class="doctor-info">
                    {% if block.settings.doctor_name != blank %}
                      <h3 class="doctor-name">{{ block.settings.doctor_name }}</h3>
                    {% endif %}
                    {% if block.settings.doctor_title != blank %}
                      <p class="doctor-title">{{ block.settings.doctor_title }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Navigation Arrows -->
        <div class="carousel-navigation">
          <button class="nav-btn prev-btn" aria-label="Previous review">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="nav-btn next-btn" aria-label="Next review">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
.dermatologist-reviews-section {
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.reviews-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.reviews-badge {
  display: inline-block;
  background-color: {{ section.settings.badge_color }};
  color: {{ section.settings.badge_text_color }};
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 24px;
}

.reviews-title {
  font-size: {{ section.settings.title_size }}px;
  color: {{ section.settings.title_color }};
  font-weight: 700;
  margin: 0 0 48px 0;
  line-height: 1.2;
}

.reviews-carousel-wrapper {
  position: relative;
  overflow: hidden;
}

.reviews-carousel {
  position: relative;
  width: 100%;
}

.review-slide {
  display: none;
  animation: fadeIn 0.5s ease-in-out;
}

.review-slide.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.review-content {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 60px;
  align-items: start;
}

.review-image {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(135deg, #A855F7 0%, #7C3AED 100%);
  aspect-ratio: 4/5;
}

.review-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.placeholder-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #A855F7 0%, #7C3AED 100%);
}

.review-details {
  padding-top: 20px;
}

.avatar-navigation {
  display: flex;
  gap: 12px;
  margin-bottom: 32px;
}

.avatar-btn {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  border: 3px solid transparent;
  background: none;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.avatar-btn.active {
  border-color: {{ section.settings.accent_color }};
  transform: scale(1.1);
}

.avatar-btn:hover {
  transform: scale(1.05);
}

.avatar-btn img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #6B7280;
}

.star-rating {
  display: flex;
  gap: 4px;
  margin-bottom: 24px;
}

.star {
  fill: #E5E7EB;
  transition: fill 0.2s ease;
}

.star.filled {
  fill: {{ section.settings.star_color }};
}

.review-text {
  font-size: 18px;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  margin: 0 0 32px 0;
  max-width: 600px;
}

.doctor-info {
  border-top: 1px solid #E5E7EB;
  padding-top: 24px;
}

.doctor-name {
  font-size: 20px;
  font-weight: 700;
  color: {{ section.settings.title_color }};
  margin: 0 0 4px 0;
}

.doctor-title {
  font-size: 16px;
  color: #6B7280;
  margin: 0;
}

.carousel-navigation {
  position: absolute;
  top: 50%;
  right: -60px;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.nav-btn {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid {{ section.settings.accent_color }};
  background: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  color: {{ section.settings.accent_color }};
}

.nav-btn:hover {
  background: {{ section.settings.accent_color }};
  color: white;
  transform: scale(1.1);
}

.nav-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .carousel-navigation {
    position: static;
    flex-direction: row;
    justify-content: center;
    margin-top: 40px;
    transform: none;
  }
  
  .review-content {
    grid-template-columns: 1fr;
    gap: 40px;
    text-align: center;
  }
  
  .review-image {
    max-width: 300px;
    margin: 0 auto;
  }
  
  .avatar-navigation {
    justify-content: center;
  }
}

@media (max-width: 768px) {
  .reviews-container {
    padding: 0 15px;
  }
  
  .review-content {
    gap: 30px;
  }
  
  .review-image {
    max-width: 250px;
  }
  
  .reviews-title {
    font-size: 28px;
    margin-bottom: 32px;
  }
  
  .review-text {
    font-size: 16px;
  }
  
  .avatar-btn {
    width: 50px;
    height: 50px;
  }
  
  .avatar-navigation {
    gap: 8px;
  }
}
</style>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const carousel = document.getElementById(`reviews-carousel-${sectionId}`);
  const slides = carousel.querySelectorAll('.review-slide');
  const avatarBtns = carousel.parentElement.querySelectorAll('.avatar-btn');
  const prevBtn = carousel.parentElement.querySelector('.prev-btn');
  const nextBtn = carousel.parentElement.querySelector('.next-btn');
  
  let currentSlide = 0;
  const totalSlides = slides.length;
  
  function showSlide(index) {
    // Hide all slides
    slides.forEach(slide => slide.classList.remove('active'));
    avatarBtns.forEach(btn => btn.classList.remove('active'));
    
    // Show current slide
    if (slides[index]) {
      slides[index].classList.add('active');
      avatarBtns[index].classList.add('active');
    }
    
    // Update navigation buttons
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === totalSlides - 1;
    
    currentSlide = index;
  }
  
  function nextSlide() {
    if (currentSlide < totalSlides - 1) {
      showSlide(currentSlide + 1);
    }
  }
  
  function prevSlide() {
    if (currentSlide > 0) {
      showSlide(currentSlide - 1);
    }
  }
  
  // Event listeners
  nextBtn.addEventListener('click', nextSlide);
  prevBtn.addEventListener('click', prevSlide);
  
  // Avatar navigation
  avatarBtns.forEach((btn, index) => {
    btn.addEventListener('click', () => showSlide(index));
  });
  
  // Keyboard navigation
  carousel.parentElement.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') prevSlide();
    if (e.key === 'ArrowRight') nextSlide();
  });
  
  // Auto-play (optional)
  {% if section.settings.auto_play %}
  let autoPlayInterval = setInterval(() => {
    if (currentSlide < totalSlides - 1) {
      nextSlide();
    } else {
      showSlide(0);
    }
  }, {{ section.settings.auto_play_speed | default: 5000 }});
  
  // Pause on hover
  carousel.parentElement.addEventListener('mouseenter', () => {
    clearInterval(autoPlayInterval);
  });
  
  carousel.parentElement.addEventListener('mouseleave', () => {
    autoPlayInterval = setInterval(() => {
      if (currentSlide < totalSlides - 1) {
        nextSlide();
      } else {
        showSlide(0);
      }
    }, {{ section.settings.auto_play_speed | default: 5000 }});
  });
  {% endif %}
  
  // Initialize
  showSlide(0);
})();
</script>

{% schema %}
{
  "name": "Dermatologist Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
